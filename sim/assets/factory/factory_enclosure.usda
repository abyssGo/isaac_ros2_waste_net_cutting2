    def "FactoryLooks"
    {
        def Material "sign_net_storage"
        {
            token outputs:surface.connect = </World/FactoryLooks/sign_net_storage/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/FactoryLooks/sign_net_storage/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/sign_net_storage.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/FactoryLooks/sign_net_storage/st.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                color3f outputs:rgb
            }
        }

        def Material "SignBacking"
        {
            token outputs:surface.connect = </World/FactoryLooks/SignBacking/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.08, 0.09)
                float inputs:metallic = 0.6
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "sign_line"
        {
            token outputs:surface.connect = </World/FactoryLooks/sign_line/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/FactoryLooks/sign_line/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }

            def Shader "st"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/sign_line.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </World/FactoryLooks/sign_line/st.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                color3f outputs:rgb
            }
        }
    }

