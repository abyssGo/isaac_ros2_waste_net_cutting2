#usda 1.0
(
    "NetClean station backdrop, step 2: matte screen behind the net at both stations."
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "StationBackdrop"
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def "Looks"
        {
            def Material "Screen"
            {
                token outputs:surface.connect = </World/StationBackdrop/Looks/Screen/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.35, 0.35, 0.35)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.95
                    token outputs:surface
                }
            }

            def Material "Aluminium"
            {
                token outputs:surface.connect = </World/StationBackdrop/Looks/Aluminium/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.62, 0.63, 0.65)
                    float inputs:metallic = 0.9
                    float inputs:roughness = 0.35
                    token outputs:surface
                }
            }
        }

        def Xform "Panel"
        {
            float3 xformOp:scale = (0.05, 10, 4.3)
            double3 xformOp:translate = (-2.625, 0, 2.15)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

            def Cube "Box" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </World/StationBackdrop/Looks/Screen>
                double size = 1
            }
        }

        def "Frame"
        {
            def Xform "Post_Left"
            {
                float3 xformOp:scale = (0.1, 0.1, 4.35)
                double3 xformOp:translate = (-2.655, -5.05, 2.175)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

                def Cube "Box" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </World/StationBackdrop/Looks/Aluminium>
                    double size = 1
                }
            }

            def Xform "Foot_Left"
            {
                float3 xformOp:scale = (0.6, 0.14, 0.04)
                double3 xformOp:translate = (-2.825, -5.05, 0.02)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

                def Cube "Box" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </World/StationBackdrop/Looks/Aluminium>
                    double size = 1
                }
            }

            def Xform "Post_Right"
            {
                float3 xformOp:scale = (0.1, 0.1, 4.35)
                double3 xformOp:translate = (-2.655, 5.05, 2.175)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

                def Cube "Box" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </World/StationBackdrop/Looks/Aluminium>
                    double size = 1
                }
            }

            def Xform "Foot_Right"
            {
                float3 xformOp:scale = (0.6, 0.14, 0.04)
                double3 xformOp:translate = (-2.825, 5.05, 0.02)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

                def Cube "Box" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </World/StationBackdrop/Looks/Aluminium>
                    double size = 1
                }
            }

            def Xform "TopRail"
            {
                float3 xformOp:scale = (0.1, 10.2, 0.1)
                double3 xformOp:translate = (-2.655, 0, 4.35)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

                def Cube "Box" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </World/StationBackdrop/Looks/Aluminium>
                    double size = 1
                }
            }
        }
    }
}

