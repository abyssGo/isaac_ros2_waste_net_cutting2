#!/usr/bin/env python3
"""NetClean 월드 실행 계층.

이 모듈은 다음을 담당한다.
- Y축 레일을 따라 NetRoot와 아직 어망에 붙어 있는 객체를 연속 이동
- Robot1/2 저수준 Lula 실행기의 상호 배제
- VG10 흡착을 모사하는 런타임 FixedJoint
- class_name -> 어망 FixedJoint 해제
- 반복 공정을 위한 명시적 cycle reset

ROS callback은 이 모듈을 직접 호출하지 않는다. 명령은 sim_ros_interface의
queue를 통해 메인 simulation thread에서만 처리된다.
"""

from __future__ import annotations

from contextlib import contextmanager
from dataclasses import dataclass
from enum import Enum, auto
import math
from typing import Callable, Dict, Iterable, List, Mapping, Optional, Sequence, Tuple

import carb
import numpy as np
try:
    from isaacsim.core.prims import SingleRigidPrim, SingleXFormPrim
except ImportError:  # Isaac Sim minor packaging 차이 대응
    from isaacsim.core.prims.impl.single_rigid_prim import SingleRigidPrim
    from isaacsim.core.prims import SingleXFormPrim
from pxr import Gf, Sdf, Usd, UsdGeom, UsdPhysics

from m0609_controller import (
    M0609Controller,
    TcpMotionRequest,
    matrix_pose,
    pose_matrix,
    quaternion_distance_rad,
)


BoolResultCallback = Callable[[bool, str], None]
StateCallback = Callable[[str], None]
FaultCallback = Callable[[str], None]
ResetDoneCallback = Callable[[bool, str], None]
ReadyCallback = Callable[[bool], None]
CycleCallback = Callable[[int], None]


def _finite_vector(values: Sequence[float], size: int, name: str) -> np.ndarray:
    result = np.asarray(values, dtype=float)
    if result.shape != (size,) or np.any(~np.isfinite(result)):
        raise ValueError(f"{name}은 길이 {size}의 유한값이어야 합니다: {result}")
    return result




@contextmanager
def _session_edit(stage: Usd.Stage):
    """런타임 속성이 원본 USD에 기록되지 않도록 session layer를 사용한다."""
    old_target = stage.GetEditTarget()
    try:
        stage.SetEditTarget(Usd.EditTarget(stage.GetSessionLayer()))
        yield
    finally:
        stage.SetEditTarget(old_target)


def _quat_wxyz_to_gf(values: Sequence[float]) -> Gf.Quatf:
    quat = _finite_vector(values, 4, "quaternion")
    norm = float(np.linalg.norm(quat))
    if norm < 1.0e-9:
        raise ValueError("0 Quaternion은 사용할 수 없습니다.")
    quat /= norm
    return Gf.Quatf(
        float(quat[0]),
        Gf.Vec3f(float(quat[1]), float(quat[2]), float(quat[3])),
    )


def _joint_enabled(stage: Usd.Stage, path: str) -> bool:
    prim = stage.GetPrimAtPath(path)
    if not prim.IsValid() or not prim.IsA(UsdPhysics.Joint):
        return False
    attr = UsdPhysics.Joint(prim).GetJointEnabledAttr()
    # USD 기본값은 True다. authored attr가 없으면 활성으로 해석한다.
    return True if not attr.IsValid() else bool(attr.Get())


def _set_joint_enabled(stage: Usd.Stage, path: str, enabled: bool) -> None:
    prim = stage.GetPrimAtPath(path)
    if not prim.IsValid() or not prim.IsA(UsdPhysics.Joint):
        raise RuntimeError(f"Physics Joint가 아닙니다: {path}")
    with _session_edit(stage):
        joint = UsdPhysics.Joint(prim)
        attr = joint.GetJointEnabledAttr()
        if not attr.IsValid():
            attr = joint.CreateJointEnabledAttr(bool(enabled))
        attr.Set(bool(enabled))
    if bool(UsdPhysics.Joint(prim).GetJointEnabledAttr().Get()) is not bool(enabled):
        raise RuntimeError(f"Joint 상태 검증 실패: {path} -> {enabled}")


def find_first_rigid_body(stage: Usd.Stage, root_path: str) -> str:
    """root subtree에서 활성 RigidBody API를 가진 첫 Prim 경로를 찾는다."""
    root = stage.GetPrimAtPath(root_path)
    if not root.IsValid():
        raise RuntimeError(f"Object root Prim이 없습니다: {root_path}")

    candidates: List[str] = []
    for prim in Usd.PrimRange(root):
        try:
            has_api = prim.HasAPI(UsdPhysics.RigidBodyAPI)
        except Exception:
            has_api = bool(UsdPhysics.RigidBodyAPI(prim))
        if not has_api:
            continue
        api = UsdPhysics.RigidBodyAPI(prim)
        enabled_attr = api.GetRigidBodyEnabledAttr()
        if not enabled_attr.IsValid() or bool(enabled_attr.Get()):
            candidates.append(str(prim.GetPath()))

    if not candidates:
        raise RuntimeError(f"RigidBody를 찾지 못했습니다: {root_path}")
    if len(candidates) > 1:
        carb.log_warn(
            f"[object registry] {root_path} 아래 RigidBody가 여러 개입니다. "
            f"첫 경로 사용: {candidates}"
        )
    return candidates[0]


@dataclass(frozen=True)
class TrackedObjectConfig:
    class_name: str
    root_prim_path: str
    net_fixed_joint_path: str
    rigid_body_prim_path: str = "auto"


class TrackedObject:
    """어망 객체의 pose, velocity, net joint 상태를 관리한다."""

    def __init__(
        self,
        stage: Usd.Stage,
        config: TrackedObjectConfig,
        rigid_body: SingleRigidPrim,
    ) -> None:
        self.stage = stage
        self.config = config
        self.rigid_body = rigid_body
        self._root_to_body = np.eye(4, dtype=float)

    @property
    def class_name(self) -> str:
        return self.config.class_name

    @property
    def root_path(self) -> str:
        return self.config.root_prim_path

    @property
    def rigid_path(self) -> str:
        # Wrapper 구현 차이에 의존하지 않고 검증된 config 경로를 사용한다.
        return self.config.rigid_body_prim_path

    @property
    def net_joint_path(self) -> str:
        return self.config.net_fixed_joint_path

    @property
    def attached_to_net(self) -> bool:
        return _joint_enabled(self.stage, self.net_joint_path)

    def snapshot_relative_to_root(
        self,
        root_position: Sequence[float],
        root_orientation_wxyz: Sequence[float],
    ) -> None:
        object_position, object_orientation = self.rigid_body.get_world_pose()
        world_root = pose_matrix(root_position, root_orientation_wxyz)
        world_body = pose_matrix(object_position, object_orientation)
        self._root_to_body = np.linalg.inv(world_root) @ world_body

    def world_pose_for_root(
        self,
        root_position: Sequence[float],
        root_orientation_wxyz: Sequence[float],
    ) -> Tuple[np.ndarray, np.ndarray]:
        world_root = pose_matrix(root_position, root_orientation_wxyz)
        return matrix_pose(world_root @ self._root_to_body)

    def restore_for_root(
        self,
        root_position: Sequence[float],
        root_orientation_wxyz: Sequence[float],
    ) -> None:
        position, orientation = self.world_pose_for_root(
            root_position, root_orientation_wxyz
        )
        self.rigid_body.set_world_pose(position=position, orientation=orientation)
        self.zero_velocity()

    def follow_root(
        self,
        root_position: Sequence[float],
        root_orientation_wxyz: Sequence[float],
    ) -> None:
        if not self.attached_to_net:
            return
        position, orientation = self.world_pose_for_root(
            root_position, root_orientation_wxyz
        )
        self.rigid_body.set_world_pose(position=position, orientation=orientation)
        self.zero_velocity()

    def zero_velocity(self) -> None:
        self.rigid_body.set_linear_velocity(np.zeros(3, dtype=float))
        self.rigid_body.set_angular_velocity(np.zeros(3, dtype=float))

    def set_net_joint_enabled(self, enabled: bool) -> None:
        _set_joint_enabled(self.stage, self.net_joint_path, enabled)

    def reset_errors_for_root(
        self,
        root_position: Sequence[float],
        root_orientation_wxyz: Sequence[float],
    ) -> Tuple[float, float, float, float]:
        """기대 초기 Pose 및 현재 속도에 대한 오차를 반환한다."""
        expected_position, expected_orientation = self.world_pose_for_root(
            root_position, root_orientation_wxyz
        )
        actual_position, actual_orientation = self.rigid_body.get_world_pose()
        position_error = float(
            np.linalg.norm(np.asarray(actual_position, dtype=float) - expected_position)
        )
        orientation_error = quaternion_distance_rad(
            actual_orientation, expected_orientation
        )
        linear_speed = float(
            np.linalg.norm(
                np.asarray(self.rigid_body.get_linear_velocity(), dtype=float)
            )
        )
        angular_speed = float(
            np.linalg.norm(
                np.asarray(self.rigid_body.get_angular_velocity(), dtype=float)
            )
        )
        return position_error, orientation_error, linear_speed, angular_speed


class NetRailController:
    """NetRoot를 고정 X/Z, Y축으로만 연속 이동한다."""

    def __init__(
        self,
        net_root: SingleXFormPrim,
        objects: Iterable[TrackedObject],
        fixed_x: float,
        fixed_z: float,
        minimum_y: float,
        maximum_y: float,
        speed_mps: float,
        position_tolerance_m: float,
        settle_time_sec: float,
        command_xz_tolerance_m: float,
    ) -> None:
        if speed_mps <= 0.0:
            raise ValueError("net speed는 0보다 커야 합니다.")
        self.net_root = net_root
        self.objects = list(objects)
        self.fixed_x = float(fixed_x)
        self.fixed_z = float(fixed_z)
        self.minimum_y = float(minimum_y)
        self.maximum_y = float(maximum_y)
        self.speed_mps = float(speed_mps)
        self.position_tolerance_m = float(position_tolerance_m)
        self.settle_time_sec = float(settle_time_sec)
        self.command_xz_tolerance_m = float(command_xz_tolerance_m)

        position, orientation = self.net_root.get_world_pose()
        self.orientation_wxyz = _finite_vector(orientation, 4, "net orientation")
        self._target_y: Optional[float] = None
        self._settled_elapsed = 0.0

    @property
    def active(self) -> bool:
        return self._target_y is not None

    @property
    def target_y(self) -> Optional[float]:
        return self._target_y

    def set_target_pose(self, target_xyz: Sequence[float]) -> None:
        target = _finite_vector(target_xyz, 3, "net target")
        if abs(float(target[0]) - self.fixed_x) > self.command_xz_tolerance_m:
            raise ValueError(
                f"Net target X가 레일에서 벗어났습니다: {target[0]} != {self.fixed_x}"
            )
        if abs(float(target[2]) - self.fixed_z) > self.command_xz_tolerance_m:
            raise ValueError(
                f"Net target Z가 레일에서 벗어났습니다: {target[2]} != {self.fixed_z}"
            )
        target_y = float(target[1])
        if target_y < self.minimum_y - 1.0e-6 or target_y > self.maximum_y + 1.0e-6:
            raise ValueError(
                f"Net target Y가 허용 레일 범위를 벗어났습니다: {target_y}, "
                f"range=[{self.minimum_y}, {self.maximum_y}]"
            )
        self._target_y = target_y
        self._settled_elapsed = 0.0
        carb.log_info(f"[net rail] target Y={target_y:.3f}")

    def cancel(self) -> None:
        self._target_y = None
        self._settled_elapsed = 0.0

    def teleport(
        self,
        position_xyz: Sequence[float],
        restore_objects: bool,
    ) -> None:
        position = _finite_vector(position_xyz, 3, "net teleport")
        self.net_root.set_world_pose(
            position=position,
            orientation=self.orientation_wxyz,
        )
        if restore_objects:
            for obj in self.objects:
                obj.restore_for_root(position, self.orientation_wxyz)
        self.cancel()

    def update(self, dt: float) -> bool:
        """목표 도착 및 settle 완료 시 True를 한 번 반환한다."""
        if self._target_y is None:
            return False

        position, _ = self.net_root.get_world_pose()
        current = np.asarray(position, dtype=float)
        delta_y = self._target_y - float(current[1])

        if abs(delta_y) <= self.position_tolerance_m:
            exact = np.array([self.fixed_x, self._target_y, self.fixed_z], dtype=float)
            self.net_root.set_world_pose(
                position=exact,
                orientation=self.orientation_wxyz,
            )
            for obj in self.objects:
                obj.follow_root(exact, self.orientation_wxyz)
            self._settled_elapsed += float(dt)
            if self._settled_elapsed >= self.settle_time_sec:
                carb.log_info(f"[net rail] reached Y={self._target_y:.3f}")
                self._target_y = None
                self._settled_elapsed = 0.0
                return True
            return False

        step = math.copysign(min(abs(delta_y), self.speed_mps * float(dt)), delta_y)
        next_position = np.array(
            [self.fixed_x, float(current[1]) + step, self.fixed_z],
            dtype=float,
        )
        self.net_root.set_world_pose(
            position=next_position,
            orientation=self.orientation_wxyz,
        )
        for obj in self.objects:
            obj.follow_root(next_position, self.orientation_wxyz)
        self._settled_elapsed = 0.0
        return False

    def get_world_pose(self) -> Tuple[np.ndarray, np.ndarray]:
        position, orientation = self.net_root.get_world_pose()
        return np.asarray(position, dtype=float), np.asarray(orientation, dtype=float)

    def distance_to(self, target_xyz: Sequence[float]) -> float:
        current, _ = self.get_world_pose()
        return float(np.linalg.norm(current - _finite_vector(target_xyz, 3, "target")))


class RuntimeSuctionController:
    """VG10 흡착을 런타임 FixedJoint로 모사한다.

    공식 Surface Gripper Schema가 없는 현재 USD를 수정하지 않기 위해 session
    layer에 객체별 FixedJoint를 미리 정의하고, 접촉 시 local joint frame만
    갱신한 뒤 한 개만 활성화한다.
    """

    def __init__(
        self,
        stage: Usd.Stage,
        robot_link_prim_path: str,
        suction_tcp: SingleXFormPrim,
        objects: Mapping[str, TrackedObject],
        runtime_root_path: str,
        max_grip_distance_m: float,
        settle_time_sec: float,
        result_callback: BoolResultCallback,
        reference_prim_path: str = "",
        forward_axis_local: Sequence[float] = (-1.0, 0.0, 0.0),
        minimum_forward_projection_m: float = -0.01,
    ) -> None:
        self.stage = stage
        self.robot_link_path = robot_link_prim_path
        self.suction_tcp = suction_tcp
        self.objects = dict(objects)
        self.runtime_root_path = runtime_root_path.rstrip("/")
        self.max_grip_distance_m = float(max_grip_distance_m)
        self.settle_time_sec = float(settle_time_sec)
        self._result_callback = result_callback
        self.reference_prim_path = str(reference_prim_path or robot_link_prim_path)
        forward = _finite_vector(forward_axis_local, 3, "suction forward axis")
        norm = float(np.linalg.norm(forward))
        if norm < 1.0e-9:
            raise ValueError("suction forward axis가 0 벡터입니다.")
        self.forward_axis_local = forward / norm
        self.minimum_forward_projection_m = float(minimum_forward_projection_m)

        self._joints: Dict[str, UsdPhysics.FixedJoint] = {}
        self._attached_class: Optional[str] = None
        self._pending_expected: Optional[bool] = None
        self._pending_elapsed = 0.0
        self._prepare_runtime_joints()

    @property
    def busy(self) -> bool:
        return self._pending_expected is not None

    @property
    def attached(self) -> bool:
        return self._attached_class is not None

    @property
    def attached_class(self) -> Optional[str]:
        return self._attached_class

    def _prepare_runtime_joints(self) -> None:
        with _session_edit(self.stage):
            UsdGeom.Xform.Define(self.stage, self.runtime_root_path)
            for class_name, obj in self.objects.items():
                joint_path = f"{self.runtime_root_path}/Suction_{class_name}"
                joint = UsdPhysics.FixedJoint.Define(self.stage, joint_path)
                joint.CreateBody0Rel().SetTargets([Sdf.Path(self.robot_link_path)])
                joint.CreateBody1Rel().SetTargets([Sdf.Path(obj.rigid_path)])
                joint.CreateCollisionEnabledAttr(False).Set(False)
                # Robot articulation과 runtime suction joint가 닫힌 loop로
                # 합쳐지지 않도록 최대좌표계 joint로 제외한다.
                joint.CreateExcludeFromArticulationAttr(True).Set(True)
                joint.CreateJointEnabledAttr(False).Set(False)
                joint.CreateLocalPos0Attr(Gf.Vec3f(0.0, 0.0, 0.0))
                joint.CreateLocalPos1Attr(Gf.Vec3f(0.0, 0.0, 0.0))
                identity_quat = Gf.Quatf(1.0, Gf.Vec3f(0.0, 0.0, 0.0))
                joint.CreateLocalRot0Attr(identity_quat)
                joint.CreateLocalRot1Attr(identity_quat)
                self._joints[class_name] = joint

    def command(self, enabled: bool) -> bool:
        if self.busy:
            return False
        if enabled:
            success, message = self._attach_nearest()
            if not success:
                self._result_callback(False, message)
                return True
            self._pending_expected = True
            self._pending_elapsed = 0.0
            return True

        self.detach_immediate()
        self._pending_expected = False
        self._pending_elapsed = 0.0
        return True

    def update(self, dt: float) -> None:
        if self._pending_expected is None:
            return
        self._pending_elapsed += float(dt)
        if self._pending_elapsed < self.settle_time_sec:
            return
        expected = self._pending_expected
        self._pending_expected = None
        self._pending_elapsed = 0.0
        actual = self.attached
        if not expected:
            actual = False
        self._result_callback(actual, "suction attached" if actual else "suction open")

    def _aabb_metrics(
        self, root_path: str, point_world: np.ndarray
    ) -> Tuple[float, np.ndarray]:
        root = self.stage.GetPrimAtPath(root_path)
        bbox_cache = UsdGeom.BBoxCache(
            Usd.TimeCode.Default(),
            [UsdGeom.Tokens.default_, UsdGeom.Tokens.render],
            useExtentsHint=True,
        )
        aligned = bbox_cache.ComputeWorldBound(root).ComputeAlignedBox()
        minimum = np.array(aligned.GetMin(), dtype=float)
        maximum = np.array(aligned.GetMax(), dtype=float)
        outside = np.maximum(
            np.maximum(minimum - point_world, 0.0), point_world - maximum
        )
        center = 0.5 * (minimum + maximum)
        return float(np.linalg.norm(outside)), center

    def _forward_axis_world(self) -> np.ndarray:
        reference = self.stage.GetPrimAtPath(self.reference_prim_path)
        if not reference.IsValid():
            raise RuntimeError(
                f"Suction reference Prim이 없습니다: {self.reference_prim_path}"
            )
        matrix = UsdGeom.XformCache().GetLocalToWorldTransform(reference)
        quat = matrix.ExtractRotationQuat()
        imag = quat.GetImaginary()
        rotation = pose_matrix(
            (0.0, 0.0, 0.0),
            (quat.GetReal(), imag[0], imag[1], imag[2]),
        )[:3, :3]
        direction = rotation @ self.forward_axis_local
        norm = float(np.linalg.norm(direction))
        if norm < 1.0e-9:
            raise RuntimeError("Suction world direction 계산 실패")
        return direction / norm

    def _attach_nearest(self) -> Tuple[bool, str]:
        if self.attached:
            return True, f"already attached: {self._attached_class}"

        tcp_position, tcp_orientation = self.suction_tcp.get_world_pose()
        tcp_position = np.asarray(tcp_position, dtype=float)
        tcp_orientation = np.asarray(tcp_orientation, dtype=float)

        try:
            forward_world = self._forward_axis_world()
        except Exception as exc:
            return False, f"흡착 방향 계산 실패: {exc}"

        candidates: List[Tuple[float, float, str, TrackedObject]] = []
        behind: List[Tuple[str, float]] = []
        for class_name, obj in self.objects.items():
            if not obj.attached_to_net:
                continue
            distance, center = self._aabb_metrics(obj.root_path, tcp_position)
            projection = float(np.dot(center - tcp_position, forward_world))
            if projection < self.minimum_forward_projection_m:
                behind.append((class_name, projection))
                continue
            # 거리 우선, 같은 거리에서는 흡착축 전방에 더 가까운 객체 우선.
            candidates.append((distance, -projection, class_name, obj))

        if not candidates:
            return (
                False,
                "흡착 가능한 전방 active 객체가 없습니다. "
                f"behind={behind}, forward={forward_world.round(4).tolist()}",
            )
        candidates.sort(key=lambda item: (item[0], item[1], item[2]))
        distance, neg_projection, class_name, obj = candidates[0]
        projection = -neg_projection
        if distance > self.max_grip_distance_m:
            return (
                False,
                f"가장 가까운 객체가 흡착 거리 밖입니다: "
                f"class={class_name}, distance={distance:.4f}m, "
                f"limit={self.max_grip_distance_m:.4f}m",
            )

        link_prim = self.stage.GetPrimAtPath(self.robot_link_path)
        link_world_matrix = UsdGeom.XformCache().GetLocalToWorldTransform(link_prim)
        # Gf Matrix4d -> NumPy는 row-major이며 translation이 마지막 행으로 보일 수
        # 있으므로 wrapper pose를 사용해 확실한 column-vector transform을 만든다.
        link_translation = link_world_matrix.ExtractTranslation()
        link_quat = link_world_matrix.ExtractRotationQuat()
        link_imag = link_quat.GetImaginary()
        world_link = pose_matrix(
            (link_translation[0], link_translation[1], link_translation[2]),
            (link_quat.GetReal(), link_imag[0], link_imag[1], link_imag[2]),
        )
        body_position, body_orientation = obj.rigid_body.get_world_pose()
        world_body = pose_matrix(body_position, body_orientation)
        world_joint = pose_matrix(tcp_position, tcp_orientation)
        link_joint = np.linalg.inv(world_link) @ world_joint
        body_joint = np.linalg.inv(world_body) @ world_joint
        local_pos0, local_rot0 = matrix_pose(link_joint)
        local_pos1, local_rot1 = matrix_pose(body_joint)

        joint = self._joints[class_name]
        with _session_edit(self.stage):
            joint.GetLocalPos0Attr().Set(Gf.Vec3f(*[float(v) for v in local_pos0]))
            joint.GetLocalRot0Attr().Set(_quat_wxyz_to_gf(local_rot0))
            joint.GetLocalPos1Attr().Set(Gf.Vec3f(*[float(v) for v in local_pos1]))
            joint.GetLocalRot1Attr().Set(_quat_wxyz_to_gf(local_rot1))
            joint.GetJointEnabledAttr().Set(True)
        if not bool(joint.GetJointEnabledAttr().Get()):
            return False, f"Runtime suction joint 활성화 실패: {class_name}"

        self._attached_class = class_name
        carb.log_info(
            f"[runtime suction] attached class={class_name}, "
            f"aabb_distance={distance:.4f}m, "
            f"forward_projection={projection:.4f}m"
        )
        return True, f"attached {class_name}"

    def detach_immediate(self) -> None:
        with _session_edit(self.stage):
            for joint in self._joints.values():
                joint.GetJointEnabledAttr().Set(False)
        if self._attached_class is not None:
            carb.log_info(f"[runtime suction] detached {self._attached_class}")
        self._attached_class = None
        self._pending_expected = None
        self._pending_elapsed = 0.0

    def all_disabled(self) -> bool:
        return all(not bool(joint.GetJointEnabledAttr().Get()) for joint in self._joints.values())


class FixedJointReleaseController:
    """class_name을 allowlist로 검증한 뒤 어망 FixedJoint를 해제한다."""

    def __init__(
        self,
        stage: Usd.Stage,
        objects: Mapping[str, TrackedObject],
        suction: RuntimeSuctionController,
        aliases: Mapping[str, str],
        result_callback: BoolResultCallback,
    ) -> None:
        self.stage = stage
        self.objects = dict(objects)
        self.suction = suction
        self.aliases = {str(k).lower(): str(v).lower() for k, v in aliases.items()}
        self._result_callback = result_callback

    def release(self, requested_class: str) -> None:
        normalized = requested_class.strip().lower()
        class_name = self.aliases.get(normalized, normalized)
        obj = self.objects.get(class_name)
        if obj is None:
            self._result_callback(False, f"unknown class_name={requested_class!r}")
            return
        if not self.suction.attached:
            self._result_callback(False, "흡착 상태가 아니므로 Joint 해제를 거부합니다.")
            return
        if self.suction.attached_class != class_name:
            self._result_callback(
                False,
                f"흡착 객체와 해제 요청이 다릅니다: "
                f"attached={self.suction.attached_class}, requested={class_name}",
            )
            return
        try:
            obj.set_net_joint_enabled(False)
        except Exception as exc:
            self._result_callback(False, f"Fixed Joint 해제 실패: {exc}")
            return
        carb.log_info(
            f"[joint release] class={class_name}, path={obj.net_joint_path}"
        )
        self._result_callback(True, f"released {class_name}")

    def restore_all(self) -> None:
        for obj in self.objects.values():
            obj.set_net_joint_enabled(True)

    def all_enabled(self) -> bool:
        return all(obj.attached_to_net for obj in self.objects.values())


class TaskState(Enum):
    STARTING = auto()
    STARTUP_STABILIZE = auto()
    STARTUP_TO_START = auto()
    READY = auto()
    NET_MOVING = auto()
    ROBOT1_MOVING = auto()
    ROBOT2_MOVING = auto()
    SUCTION_TRANSITION = auto()
    RESETTING = auto()
    RESET_STABILIZE = auto()
    RESET_TO_START = auto()
    FAULT = auto()


@dataclass(frozen=True)
class ResetConfig:
    spawn_xyz: Tuple[float, float, float]
    start_xyz: Tuple[float, float, float]
    stabilize_steps: int
    robot_home_tolerance_rad: float
    net_tolerance_m: float
    object_position_tolerance_m: float
    object_orientation_tolerance_rad: float
    object_linear_speed_tolerance_mps: float
    object_angular_speed_tolerance_rad_s: float


class NetCleanTask:
    """Standalone의 단일 simulation-thread 상태 관리자."""

    def __init__(
        self,
        net: NetRailController,
        objects: Mapping[str, TrackedObject],
        robot1: M0609Controller,
        robot2: M0609Controller,
        suction: RuntimeSuctionController,
        joint_release: FixedJointReleaseController,
        reset_config: ResetConfig,
        ready_callback: ReadyCallback,
        reset_done_callback: ResetDoneCallback,
        state_callback: StateCallback,
        fault_callback: FaultCallback,
        cycle_callback: CycleCallback,
    ) -> None:
        self.net = net
        self.objects = dict(objects)
        self.robot1 = robot1
        self.robot2 = robot2
        self.suction = suction
        self.joint_release = joint_release
        self.reset_config = reset_config
        self._ready_callback = ready_callback
        self._reset_done_callback = reset_done_callback
        self._state_callback = state_callback
        self._fault_callback = fault_callback
        self._cycle_callback = cycle_callback

        self.state = TaskState.STARTING
        self._state_steps = 0
        self._cycle = 1
        self._reset_requested = False
        self._normal_net_move = False
        self._set_state(TaskState.STARTING)

    @property
    def ready(self) -> bool:
        return self.state in {TaskState.READY, TaskState.NET_MOVING, TaskState.ROBOT1_MOVING,
                              TaskState.ROBOT2_MOVING, TaskState.SUCTION_TRANSITION}

    @property
    def faulted(self) -> bool:
        return self.state is TaskState.FAULT

    @property
    def cycle(self) -> int:
        return self._cycle

    def start(self) -> None:
        """첫 cycle의 SPAWN 복구를 시작한다."""
        try:
            self._ready_callback(False)
            self.robot1.set_home_immediate()
            self.robot2.set_home_immediate()
            self.suction.detach_immediate()
            self.net.teleport(self.reset_config.spawn_xyz, restore_objects=True)
            for obj in self.objects.values():
                obj.zero_velocity()
            self.joint_release.restore_all()
            self._state_steps = 0
            self._set_state(TaskState.STARTUP_STABILIZE)
        except Exception as exc:
            self._enter_fault(f"startup 초기화 실패: {exc}")

    def request_reset(self) -> None:
        self._reset_requested = True

    def submit_net_target(self, target_xyz: Sequence[float]) -> bool:
        if self.state is not TaskState.READY:
            return False
        if self.robot1.busy or self.robot2.busy or self.suction.attached:
            return False
        try:
            self.net.set_target_pose(target_xyz)
        except Exception as exc:
            carb.log_error(f"[net target] rejected: {exc}")
            return False
        self._normal_net_move = True
        self._set_state(TaskState.NET_MOVING)
        return True

    def submit_robot1(self, request: TcpMotionRequest) -> bool:
        if (
            self.state is not TaskState.READY
            or self.net.active
            or self.robot2.busy
            or self.suction.attached
        ):
            return False
        if not self.robot1.submit(request):
            return False
        self._set_state(TaskState.ROBOT1_MOVING)
        return True

    def submit_robot2(self, request: TcpMotionRequest) -> bool:
        if self.state is not TaskState.READY or self.net.active or self.robot1.busy:
            return False
        if not self.robot2.submit(request):
            return False
        self._set_state(TaskState.ROBOT2_MOVING)
        return True

    def submit_suction(self, enabled: bool) -> bool:
        if self.state is not TaskState.READY:
            return False
        if self.net.active or self.robot1.busy or self.robot2.busy:
            return False
        # attach 실패는 command() 내부에서 결과 callback을 즉시 호출할 수 있으므로
        # callback 전에 상태를 먼저 전환한다.
        self._set_state(TaskState.SUCTION_TRANSITION)
        accepted = self.suction.command(bool(enabled))
        if not accepted:
            self._set_state(TaskState.READY)
        return accepted

    def submit_joint_release(self, class_name: str) -> bool:
        if self.state is not TaskState.READY:
            return False
        if self.net.active or self.robot1.busy or self.robot2.busy or self.suction.busy:
            return False
        self.joint_release.release(class_name)
        return True

    def on_robot1_result(self) -> None:
        if self.state is TaskState.ROBOT1_MOVING:
            self._set_state(TaskState.READY)

    def on_robot2_result(self) -> None:
        if self.state is TaskState.ROBOT2_MOVING:
            self._set_state(TaskState.READY)

    def on_suction_result(self) -> None:
        if self.state is TaskState.SUCTION_TRANSITION:
            self._set_state(TaskState.READY)

    def update(self, dt: float) -> None:
        if self.state is TaskState.FAULT:
            return

        if self._reset_requested:
            self._reset_requested = False
            self._begin_reset()

        self.robot1.update(dt)
        self.robot2.update(dt)
        self.suction.update(dt)

        if self.state is TaskState.STARTUP_STABILIZE:
            self._state_steps += 1
            if self._state_steps >= self.reset_config.stabilize_steps:
                self.net.set_target_pose(self.reset_config.start_xyz)
                self._set_state(TaskState.STARTUP_TO_START)
            return

        if self.state is TaskState.STARTUP_TO_START:
            if self.net.update(dt):
                self._verify_reset_state("startup")
                if not self.faulted:
                    self._set_state(TaskState.READY)
                    self._ready_callback(True)
                    self._cycle_callback(self._cycle)
            return

        if self.state is TaskState.NET_MOVING:
            if self.net.update(dt):
                self._normal_net_move = False
                self._set_state(TaskState.READY)
            return

        if self.state is TaskState.RESET_STABILIZE:
            self._state_steps += 1
            if self._state_steps >= self.reset_config.stabilize_steps:
                self.net.set_target_pose(self.reset_config.start_xyz)
                self._set_state(TaskState.RESET_TO_START)
            return

        if self.state is TaskState.RESET_TO_START:
            if self.net.update(dt):
                self._verify_reset_state("cycle reset")
                if not self.faulted:
                    self._cycle += 1
                    self._cycle_callback(self._cycle)
                    self._set_state(TaskState.READY)
                    self._ready_callback(True)
                    self._reset_done_callback(True, "cycle reset completed")
            return

    def _begin_reset(self) -> None:
        self._set_state(TaskState.RESETTING)
        self._ready_callback(False)
        try:
            self.net.cancel()
            self.robot1.cancel("cycle reset")
            self.robot2.cancel("cycle reset")
            self.suction.detach_immediate()
            self.robot1.set_home_immediate()
            self.robot2.set_home_immediate()
            self.net.teleport(self.reset_config.spawn_xyz, restore_objects=True)
            for obj in self.objects.values():
                obj.zero_velocity()
            self.joint_release.restore_all()
            self._state_steps = 0
            self._set_state(TaskState.RESET_STABILIZE)
        except Exception as exc:
            self._reset_done_callback(False, str(exc))
            self._enter_fault(f"cycle reset 실패: {exc}")

    def _verify_reset_state(self, label: str) -> None:
        failures: List[str] = []
        if self.suction.attached or not self.suction.all_disabled():
            failures.append("runtime suction joint가 열리지 않음")
        if not self.joint_release.all_enabled():
            failures.append("어망 객체 FixedJoint 중 비활성 상태 존재")
        if self.robot1.home_error_rad() > self.reset_config.robot_home_tolerance_rad:
            failures.append(
                f"robot1 HOME 오차={self.robot1.home_error_rad():.4f}rad"
            )
        if self.robot2.home_error_rad() > self.reset_config.robot_home_tolerance_rad:
            failures.append(
                f"robot2 HOME 오차={self.robot2.home_error_rad():.4f}rad"
            )
        if self.net.distance_to(self.reset_config.start_xyz) > self.reset_config.net_tolerance_m:
            failures.append("NetRoot가 START에 도착하지 않음")
        for class_name, obj in self.objects.items():
            try:
                pos_err, rot_err, linear_speed, angular_speed = (
                    obj.reset_errors_for_root(
                        self.reset_config.start_xyz,
                        self.net.orientation_wxyz,
                    )
                )
            except Exception as exc:
                failures.append(f"{class_name} reset 상태 조회 실패: {exc}")
                continue
            if pos_err > self.reset_config.object_position_tolerance_m:
                failures.append(
                    f"{class_name} 초기 위치 오차={pos_err:.4f}m"
                )
            if rot_err > self.reset_config.object_orientation_tolerance_rad:
                failures.append(
                    f"{class_name} 초기 방향 오차={math.degrees(rot_err):.2f}deg"
                )
            if linear_speed > self.reset_config.object_linear_speed_tolerance_mps:
                failures.append(
                    f"{class_name} 선속도={linear_speed:.4f}m/s"
                )
            if angular_speed > self.reset_config.object_angular_speed_tolerance_rad_s:
                failures.append(
                    f"{class_name} 각속도={angular_speed:.4f}rad/s"
                )
        if failures:
            self._enter_fault(f"{label} 검증 실패: " + "; ".join(failures))

    def report_fault(self, message: str) -> None:
        self._enter_fault(str(message))

    def _set_state(self, state: TaskState) -> None:
        self.state = state
        self._state_steps = 0
        self._state_callback(state.name)
        carb.log_info(f"[NetClean state] {state.name}")

    def _enter_fault(self, message: str) -> None:
        self.state = TaskState.FAULT
        self._ready_callback(False)
        self._state_callback(TaskState.FAULT.name)
        self._fault_callback(message)
        carb.log_error(f"[NetClean FAULT] {message}")
