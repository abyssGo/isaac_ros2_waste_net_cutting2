#!/usr/bin/env python3
"""M0609 Lula IK, TCP 보정, 관절 보간 및 도착 검증."""

from __future__ import annotations

from dataclasses import dataclass
from typing import Callable, Optional, Sequence, Tuple

import carb
import numpy as np
from isaacsim.core.prims import SingleArticulation, SingleXFormPrim
from isaacsim.core.utils.types import ArticulationAction
from isaacsim.robot_motion.motion_generation import (
    ArticulationKinematicsSolver,
    LulaKinematicsSolver,
)

from motion_interpolator import QuinticJointTrajectory


ResultCallback = Callable[[bool, str], None]


def _finite_vector(values: Sequence[float], size: int, name: str) -> np.ndarray:
    array = np.asarray(values, dtype=float)
    if array.shape != (size,) or not np.all(np.isfinite(array)):
        raise ValueError(f"{name}은 길이 {size}의 유한값이어야 합니다: {array}")
    return array


def normalize_quaternion_wxyz(values: Sequence[float], name: str) -> np.ndarray:
    quat = _finite_vector(values, 4, name)
    norm = float(np.linalg.norm(quat))
    if norm < 1.0e-9:
        raise ValueError(f"{name}: 크기가 0인 Quaternion입니다.")
    return quat / norm


def quaternion_to_matrix_wxyz(quat: Sequence[float]) -> np.ndarray:
    w, x, y, z = normalize_quaternion_wxyz(quat, "quaternion")
    return np.array(
        [
            [1.0 - 2.0 * (y * y + z * z), 2.0 * (x * y - z * w), 2.0 * (x * z + y * w)],
            [2.0 * (x * y + z * w), 1.0 - 2.0 * (x * x + z * z), 2.0 * (y * z - x * w)],
            [2.0 * (x * z - y * w), 2.0 * (y * z + x * w), 1.0 - 2.0 * (x * x + y * y)],
        ],
        dtype=float,
    )


def matrix_to_quaternion_wxyz(rotation: Sequence[Sequence[float]]) -> np.ndarray:
    """3x3 회전행렬을 scalar-first Quaternion으로 변환한다."""
    matrix = np.asarray(rotation, dtype=float)
    if matrix.shape != (3, 3) or not np.all(np.isfinite(matrix)):
        raise ValueError("rotation은 유효한 3x3 행렬이어야 합니다.")

    trace = float(np.trace(matrix))
    if trace > 0.0:
        scale = np.sqrt(trace + 1.0) * 2.0
        w = 0.25 * scale
        x = (matrix[2, 1] - matrix[1, 2]) / scale
        y = (matrix[0, 2] - matrix[2, 0]) / scale
        z = (matrix[1, 0] - matrix[0, 1]) / scale
    elif matrix[0, 0] > matrix[1, 1] and matrix[0, 0] > matrix[2, 2]:
        scale = np.sqrt(1.0 + matrix[0, 0] - matrix[1, 1] - matrix[2, 2]) * 2.0
        w = (matrix[2, 1] - matrix[1, 2]) / scale
        x = 0.25 * scale
        y = (matrix[0, 1] + matrix[1, 0]) / scale
        z = (matrix[0, 2] + matrix[2, 0]) / scale
    elif matrix[1, 1] > matrix[2, 2]:
        scale = np.sqrt(1.0 + matrix[1, 1] - matrix[0, 0] - matrix[2, 2]) * 2.0
        w = (matrix[0, 2] - matrix[2, 0]) / scale
        x = (matrix[0, 1] + matrix[1, 0]) / scale
        y = 0.25 * scale
        z = (matrix[1, 2] + matrix[2, 1]) / scale
    else:
        scale = np.sqrt(1.0 + matrix[2, 2] - matrix[0, 0] - matrix[1, 1]) * 2.0
        w = (matrix[1, 0] - matrix[0, 1]) / scale
        x = (matrix[0, 2] + matrix[2, 0]) / scale
        y = (matrix[1, 2] + matrix[2, 1]) / scale
        z = 0.25 * scale
    return normalize_quaternion_wxyz((w, x, y, z), "computed quaternion")


def pose_matrix(position: Sequence[float], orientation_wxyz: Sequence[float]) -> np.ndarray:
    transform = np.eye(4, dtype=float)
    transform[:3, :3] = quaternion_to_matrix_wxyz(orientation_wxyz)
    transform[:3, 3] = _finite_vector(position, 3, "position")
    return transform


def matrix_pose(transform: Sequence[Sequence[float]]) -> Tuple[np.ndarray, np.ndarray]:
    matrix = np.asarray(transform, dtype=float)
    if matrix.shape != (4, 4) or not np.all(np.isfinite(matrix)):
        raise ValueError("transform은 유효한 4x4 행렬이어야 합니다.")
    return matrix[:3, 3].copy(), matrix_to_quaternion_wxyz(matrix[:3, :3])


def quaternion_distance_rad(a: Sequence[float], b: Sequence[float]) -> float:
    qa = normalize_quaternion_wxyz(a, "qa")
    qb = normalize_quaternion_wxyz(b, "qb")
    dot = min(1.0, abs(float(np.dot(qa, qb))))
    return 2.0 * float(np.arccos(dot))


@dataclass(frozen=True)
class M0609Config:
    name: str
    urdf_path: str
    descriptor_path: str
    end_effector_frame: str
    tcp_prim_path: str
    flange_to_tcp_position_m: Tuple[float, float, float]
    flange_to_tcp_quaternion_wxyz: Tuple[float, float, float, float]
    safe_home_joints_rad: Tuple[float, float, float, float, float, float]
    stiffness: Tuple[float, float, float, float, float, float]
    damping: Tuple[float, float, float, float, float, float]
    max_effort: Tuple[float, float, float, float, float, float]
    velocity_limit_rad_s: Tuple[float, float, float, float, float, float]
    apply_runtime_gains: bool = False
    apply_runtime_effort_limits: bool = False
    minimum_motion_duration_sec: float = 0.50
    maximum_motion_duration_sec: float = 30.0
    timeout_scale: float = 3.0
    timeout_margin_sec: float = 3.0
    joint_tolerance_rad: float = np.deg2rad(2.0)
    tcp_position_tolerance_m: float = 0.012
    tcp_orientation_tolerance_rad: float = np.deg2rad(8.0)
    settle_time_sec: float = 0.15
    max_joint_delta_rad: float = np.deg2rad(200.0)


@dataclass(frozen=True)
class TcpMotionRequest:
    position_world: np.ndarray
    orientation_world_wxyz: np.ndarray


class M0609Controller:
    """한 M0609의 저수준 실행기. 동시에 한 명령만 허용한다."""

    def __init__(
        self,
        robot: SingleArticulation,
        tcp_prim: SingleXFormPrim,
        config: M0609Config,
        result_callback: ResultCallback,
    ) -> None:
        self.robot = robot
        self.tcp_prim = tcp_prim
        self.config = config
        self._result_callback = result_callback

        self._flange_to_tcp = pose_matrix(
            config.flange_to_tcp_position_m,
            config.flange_to_tcp_quaternion_wxyz,
        )
        self._home = _finite_vector(config.safe_home_joints_rad, 6, "safe_home")
        self._velocity_limits = _finite_vector(
            config.velocity_limit_rad_s, 6, "velocity_limit_rad_s"
        )

        self._lula = LulaKinematicsSolver(
            robot_description_path=config.descriptor_path,
            urdf_path=config.urdf_path,
        )
        available_frames = set(self._lula.get_all_frame_names())
        if config.end_effector_frame not in available_frames:
            raise RuntimeError(
                f"[{config.name}] Lula frame {config.end_effector_frame!r}가 없습니다. "
                f"available={sorted(available_frames)}"
            )
        base_position, base_orientation = self.robot.get_world_pose()
        self._lula.set_robot_base_pose(base_position, base_orientation)
        self._ik = ArticulationKinematicsSolver(
            self.robot,
            self._lula,
            config.end_effector_frame,
        )

        self._pending: Optional[TcpMotionRequest] = None
        self._active_request: Optional[TcpMotionRequest] = None
        self._trajectory: Optional[QuinticJointTrajectory] = None
        self._indices = np.array([], dtype=np.int64)
        self._target_joints = np.array([], dtype=float)
        self._motion_elapsed = 0.0
        self._timeout = 0.0
        self._settled_elapsed = 0.0

        self._apply_drive_settings()

    @property
    def busy(self) -> bool:
        return self._pending is not None or self._trajectory is not None

    @property
    def home_joints(self) -> np.ndarray:
        return self._home.copy()

    def _apply_drive_settings(self) -> None:
        if not self.config.apply_runtime_gains:
            carb.log_warn(f"[{self.config.name}] runtime gain override disabled")
            return
        controller = self.robot.get_articulation_controller()
        kps = _finite_vector(self.config.stiffness, 6, "stiffness")
        kds = _finite_vector(self.config.damping, 6, "damping")
        max_effort = _finite_vector(self.config.max_effort, 6, "max_effort")
        try:
            controller.set_gains(kps=kps, kds=kds, save_to_usd=False)
            if self.config.apply_runtime_effort_limits and hasattr(controller, "set_max_efforts"):
                controller.set_max_efforts(max_effort)
            actual_kps, actual_kds = controller.get_gains()
        except Exception as exc:
            raise RuntimeError(
                f"[{self.config.name}] runtime gain 적용 실패: {exc}"
            ) from exc
        carb.log_info(
            f"[{self.config.name}] gains applied (first-test candidate): "
            f"kp={np.asarray(actual_kps).round(4).tolist()}, "
            f"kd={np.asarray(actual_kds).round(4).tolist()}"
        )

    def submit(self, request: TcpMotionRequest) -> bool:
        if self.busy:
            return False
        position = _finite_vector(request.position_world, 3, "target position")
        orientation = normalize_quaternion_wxyz(
            request.orientation_world_wxyz,
            "target orientation",
        )
        self._pending = TcpMotionRequest(position.copy(), orientation.copy())
        return True

    def cancel(self, reason: str = "cancelled") -> None:
        had_motion = self.busy
        self._pending = None
        self._active_request = None
        self._trajectory = None
        self._indices = np.array([], dtype=np.int64)
        self._target_joints = np.array([], dtype=float)
        self._motion_elapsed = 0.0
        self._settled_elapsed = 0.0
        if had_motion:
            carb.log_warn(f"[{self.config.name}] motion {reason}")

    def set_home_immediate(self) -> None:
        """Reset 전용. 정상 공정 중에는 사용하지 않는다."""
        self.cancel("reset")
        self.robot.set_joint_positions(self._home)
        self.robot.set_joint_velocities(np.zeros_like(self._home))
        try:
            self.robot.set_joint_efforts(np.zeros_like(self._home))
        except Exception:
            pass
        # Reset/teleport 이후에도 position target을 HOME으로 유지한다.
        self.robot.apply_action(ArticulationAction(joint_positions=self._home))
        base_position, base_orientation = self.robot.get_world_pose()
        self._lula.set_robot_base_pose(base_position, base_orientation)

    def home_error_rad(self) -> float:
        current = np.asarray(self.robot.get_joint_positions(), dtype=float)
        return float(np.max(np.abs(current[:6] - self._home)))

    def update(self, dt: float) -> None:
        if self._trajectory is None and self._pending is not None:
            request = self._pending
            self._pending = None
            if not self._begin(request):
                self._finish(False, "IK failed or unsafe joint jump")
                return

        if self._trajectory is None:
            return

        self._motion_elapsed += float(dt)
        command = self._trajectory.sample(dt)
        self.robot.apply_action(
            ArticulationAction(
                joint_positions=command,
                joint_indices=self._indices,
            )
        )

        if self._trajectory.complete:
            # 마지막 target을 계속 걸어 실제 joint/TCP가 안정화될 시간을 준다.
            self.robot.apply_action(
                ArticulationAction(
                    joint_positions=self._target_joints,
                    joint_indices=self._indices,
                )
            )
            if self._reached_target():
                self._settled_elapsed += float(dt)
                if self._settled_elapsed >= self.config.settle_time_sec:
                    self._finish(True, "target reached")
                    return
            else:
                self._settled_elapsed = 0.0

        if self._motion_elapsed > self._timeout:
            self._finish(False, f"motion timeout ({self._timeout:.2f}s)")

    def _begin(self, request: TcpMotionRequest) -> bool:
        try:
            world_tcp = pose_matrix(
                request.position_world,
                request.orientation_world_wxyz,
            )
            world_flange = world_tcp @ np.linalg.inv(self._flange_to_tcp)
            flange_position, flange_orientation = matrix_pose(world_flange)

            base_position, base_orientation = self.robot.get_world_pose()
            self._lula.set_robot_base_pose(base_position, base_orientation)
            target_action, success = self._ik.compute_inverse_kinematics(
                target_position=flange_position,
                target_orientation=flange_orientation,
            )
        except Exception as exc:
            carb.log_error(f"[{self.config.name}] IK exception: {exc}")
            return False

        if not success or target_action.joint_positions is None:
            carb.log_error(f"[{self.config.name}] IK did not converge")
            return False

        target = np.asarray(target_action.joint_positions, dtype=float)
        if target_action.joint_indices is None:
            indices = np.arange(target.size, dtype=np.int64)
        else:
            indices = np.asarray(target_action.joint_indices, dtype=np.int64)

        if target.ndim != 1 or target.size != indices.size:
            carb.log_error(
                f"[{self.config.name}] invalid IK action shape: "
                f"positions={target.shape}, indices={indices.shape}"
            )
            return False
        if np.any(~np.isfinite(target)):
            carb.log_error(f"[{self.config.name}] IK returned NaN/Inf")
            return False
        if np.any(indices < 0) or np.any(indices >= self._velocity_limits.size):
            carb.log_error(f"[{self.config.name}] unexpected joint indices: {indices}")
            return False

        start = np.asarray(
            self.robot.get_joint_positions(joint_indices=indices),
            dtype=float,
        )
        delta = np.abs(target - start)
        if float(np.max(delta, initial=0.0)) > self.config.max_joint_delta_rad:
            carb.log_error(
                f"[{self.config.name}] rejected large IK jump: "
                f"max={np.rad2deg(np.max(delta)):.1f} deg"
            )
            return False

        try:
            trajectory = QuinticJointTrajectory.create(
                start=start,
                target=target,
                velocity_limits=self._velocity_limits[indices],
                minimum_duration=self.config.minimum_motion_duration_sec,
                maximum_duration=self.config.maximum_motion_duration_sec,
            )
        except ValueError as exc:
            carb.log_error(f"[{self.config.name}] trajectory rejected: {exc}")
            return False

        self._active_request = request
        self._trajectory = trajectory
        self._indices = indices
        self._target_joints = target
        self._motion_elapsed = 0.0
        self._settled_elapsed = 0.0
        self._timeout = max(
            5.0,
            trajectory.duration * self.config.timeout_scale
            + self.config.timeout_margin_sec,
        )
        carb.log_info(
            f"[{self.config.name}] motion started: duration={trajectory.duration:.2f}s, "
            f"timeout={self._timeout:.2f}s, target_tcp={request.position_world.tolist()}"
        )
        return True

    def _reached_target(self) -> bool:
        current = np.asarray(
            self.robot.get_joint_positions(joint_indices=self._indices),
            dtype=float,
        )
        joint_error = float(np.max(np.abs(current - self._target_joints)))
        if joint_error > self.config.joint_tolerance_rad:
            return False

        request = self._active_request
        if request is None:
            return False
        try:
            actual_position, actual_orientation = self.tcp_prim.get_world_pose()
            position_error = float(
                np.linalg.norm(np.asarray(actual_position) - request.position_world)
            )
            orientation_error = quaternion_distance_rad(
                actual_orientation,
                request.orientation_world_wxyz,
            )
        except Exception as exc:
            carb.log_warn(
                f"[{self.config.name}] TCP marker verification unavailable: {exc}"
            )
            return True

        return (
            position_error <= self.config.tcp_position_tolerance_m
            and orientation_error <= self.config.tcp_orientation_tolerance_rad
        )

    def _finish(self, success: bool, message: str) -> None:
        carb.log_info(
            f"[{self.config.name}] motion result={success}: {message}"
        )
        self._pending = None
        self._active_request = None
        self._trajectory = None
        self._indices = np.array([], dtype=np.int64)
        self._target_joints = np.array([], dtype=float)
        self._motion_elapsed = 0.0
        self._settled_elapsed = 0.0
        self._result_callback(bool(success), message)
