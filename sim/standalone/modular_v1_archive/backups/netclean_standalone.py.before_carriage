def _parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="NetClean Isaac Sim standalone")
    parser.add_argument(
        "--config",
        default=str(DEFAULT_CONFIG),
        help="sim_config.yaml 경로",
    )
    parser.add_argument(
        "--usd",
        default="",
        help="config의 world.usd_path를 덮어쓸 절대 경로",
    )
    parser.add_argument(
        "--mode",
        choices=("world_only", "net_only", "full"),
        default="full",
        help=("world_only: 월드/Action Graph/ROS smoke, "
              "net_only: HOME/Reset/Net rail만, full: 전체 저수준 실행"),
    )
    parser.add_argument("--headless", action="store_true")
    parser.add_argument(
        "--validate-only",
        action="store_true",
        help="Stage/설정 검증 후 종료",
    )
    args, unknown = parser.parse_known_args()
    # Isaac/Kit launcher가 자체 인자를 붙이는 경우를 허용한다.
    if unknown:
        print(f"[NetClean] ignoring launcher arguments: {unknown}")
    return args


