def _load_yaml(path: str) -> Dict[str, Any]:
    config_path = Path(path).expanduser().resolve()
    if not config_path.is_file():
        raise FileNotFoundError(f"config 파일이 없습니다: {config_path}")
    with config_path.open("r", encoding="utf-8") as stream:
        data = yaml.safe_load(stream)
    if not isinstance(data, dict):
        raise ValueError("sim_config.yaml 최상위는 mapping이어야 합니다.")
    data["_config_path"] = str(config_path)
    return data


def _section(config: Mapping[str, Any], key: str) -> Dict[str, Any]:
    value = config.get(key)
    if not isinstance(value, dict):
        raise ValueError(f"config section이 없거나 mapping이 아닙니다: {key}")
    return dict(value)


def _absolute_file(value: str, name: str) -> str:
    path = Path(str(value)).expanduser()
    if not path.is_absolute():
        raise ValueError(f"{name}은 절대경로여야 합니다: {path}")
    if not path.is_file():
        raise FileNotFoundError(f"{name} 파일이 없습니다: {path}")
    return str(path)


def _float_tuple(values: Sequence[Any], size: int, name: str) -> tuple:
    result = tuple(float(v) for v in values)
    if len(result) != size or not np.all(np.isfinite(result)):
        raise ValueError(f"{name}은 길이 {size}의 유한값이어야 합니다: {result}")
    return result


def _required_prim(stage: Usd.Stage, path: str, label: str):
    prim = stage.GetPrimAtPath(path)
    if not prim.IsValid():
        raise RuntimeError(f"Stage Prim 누락: {label}: {path}")
    return prim


def _local_pose_from_prim(prim) -> tuple[np.ndarray, np.ndarray]:
    xformable = UsdGeom.Xformable(prim)
    value = xformable.GetLocalTransformation()
    matrix = value[0] if isinstance(value, tuple) else value
    translation = matrix.ExtractTranslation()
    rotation = matrix.ExtractRotationQuat()
    imaginary = rotation.GetImaginary()
    position = np.asarray(
        (translation[0], translation[1], translation[2]), dtype=float
    )
    quaternion_wxyz = np.asarray(
        (rotation.GetReal(), imaginary[0], imaginary[1], imaginary[2]), dtype=float
    )
    norm = float(np.linalg.norm(quaternion_wxyz))
    if norm < 1.0e-9:
        raise RuntimeError(f"0 Quaternion Prim: {prim.GetPath()}")
    return position, quaternion_wxyz / norm


def _validate_tcp_marker(
    stage: Usd.Stage,
    prim_path: str,
    expected_parent: str,
    expected_position: Sequence[float],
    expected_quaternion_wxyz: Sequence[float],
    label: str,
) -> None:
    prim = _required_prim(stage, prim_path, label)
    actual_parent = str(prim.GetParent().GetPath())
    if actual_parent != expected_parent:
        raise RuntimeError(
            f"{label} parent 불일치: {actual_parent} != {expected_parent}"
        )
    position, quaternion = _local_pose_from_prim(prim)
    expected_p = np.asarray(expected_position, dtype=float)
    expected_q = np.asarray(expected_quaternion_wxyz, dtype=float)
    expected_q /= max(float(np.linalg.norm(expected_q)), 1.0e-12)
    position_error = float(np.linalg.norm(position - expected_p))
    orientation_dot = min(1.0, abs(float(np.dot(quaternion, expected_q))))
    orientation_error = 2.0 * math.acos(orientation_dot)
    if position_error > 0.002:
        raise RuntimeError(
            f"{label} local position 불일치: actual={position.tolist()}, "
            f"expected={expected_p.tolist()}, error={position_error:.6f}m"
        )
    if orientation_error > math.radians(1.0):
        raise RuntimeError(
            f"{label} local orientation 불일치: error="
            f"{math.degrees(orientation_error):.3f}deg"
        )


def _wait_for_stage_loading(max_updates: int = 3600, stable_updates: int = 10) -> None:
    """Payload/reference loading이 실제로 끝날 때까지 기다린다."""
    from isaacsim.core.utils.stage import is_stage_loading

    stable = 0

    for update_index in range(max_updates):
        simulation_app.update()

        try:
            loading = bool(is_stage_loading())
        except Exception:
            # 일부 minor build를 위한 fallback.
            try:
                _message, _loaded, pending = omni.usd.get_context().get_stage_loading_status()
                loading = int(pending) > 0
            except Exception:
                # API 확인 자체가 불가능할 때만 짧은 warm-up 후 진행.
                if update_index >= 30:
                    print("[NetClean] stage loading API unavailable; continuing after warm-up", flush=True)
                    return
                continue

        if loading:
            stable = 0
        else:
            stable += 1
            if stable >= stable_updates:
                print(
                    f"[NetClean] stage loading completed "
                    f"(updates={update_index + 1})",
                    flush=True,
                )
                return

    raise TimeoutError(
        f"Stage loading did not settle after {max_updates} Kit updates"
    )


def _validate_stage(
    stage: Usd.Stage,
    config: Mapping[str, Any],
    full: bool,
) -> None:
    world_cfg = _section(config, "world")
    paths = _section(config, "prim_paths")

    meters = float(UsdGeom.GetStageMetersPerUnit(stage))
    expected_meters = float(world_cfg.get("meters_per_unit", 1.0))
    if abs(meters - expected_meters) > 1.0e-6:
        raise RuntimeError(
            f"Stage metersPerUnit 불일치: stage={meters}, config={expected_meters}"
        )
    up_axis = str(UsdGeom.GetStageUpAxis(stage)).upper()
    if up_axis != str(world_cfg.get("up_axis", "Z")).upper():
        raise RuntimeError(f"Stage up-axis 불일치: {up_axis}")

    _required_prim(stage, paths["physics_scene"], "PhysicsScene")
    _required_prim(stage, paths["net_root"], "NetRoot")
    _required_prim(stage, paths["clock_graph"], "Clock Action Graph")
    _required_prim(stage, paths["camera1_graph"], "Camera1 Action Graph")
    _required_prim(stage, paths["camera2_graph"], "Camera2 Action Graph")
    _required_prim(stage, paths["camera1"], "Camera1")
    _required_prim(stage, paths["camera2"], "Camera2")

    if not full:
        return

    _required_prim(stage, paths["robot1"], "Robot1 articulation")
    _required_prim(stage, paths["robot2"], "Robot2 articulation")
    _required_prim(stage, paths["robot1_tcp"], "CutterTCP")
    _required_prim(stage, paths["robot2_tcp"], "SuctionTCP")
    _required_prim(stage, paths["robot2_link6"], "Robot2 link_6")

    objects = _section(config, "objects")
    for class_name, object_cfg in objects.items():
        if not isinstance(object_cfg, dict):
            raise ValueError(f"objects.{class_name}은 mapping이어야 합니다.")
        _required_prim(stage, object_cfg["root_prim_path"], f"{class_name} root")
        joint_path = object_cfg["net_fixed_joint_path"]
        joint_prim = _required_prim(stage, joint_path, f"{class_name} net FixedJoint")
        if not joint_prim.IsA(UsdPhysics.FixedJoint):
            raise RuntimeError(f"FixedJoint 타입이 아닙니다: {joint_path}")

    # URDF/Lula와 사용자가 저장한 TCP Marker를 validate-only 단계에서도 확인한다.
    m0609_cfg = _section(config, "m0609")
    _absolute_file(m0609_cfg["urdf_path"], "m0609.urdf_path")
    _absolute_file(
        m0609_cfg["lula_descriptor_path"],
        "m0609.lula_descriptor_path",
    )
    robot1_cfg = _section(config, "robot1")
    robot2_cfg = _section(config, "robot2")
    _validate_tcp_marker(
        stage,
        paths["robot1_tcp"],
        paths["robot1_link6"],
        robot1_cfg["flange_to_tcp_position_m"],
        robot1_cfg["flange_to_tcp_quaternion_wxyz"],
        "Robot1 CutterTCP",
    )
    _validate_tcp_marker(
        stage,
        paths["robot2_tcp"],
        paths["robot2_link6"],
        robot2_cfg["flange_to_tcp_position_m"],
        robot2_cfg["flange_to_tcp_quaternion_wxyz"],
        "Robot2 SuctionTCP",
    )

    suction_cfg = _section(config, "suction")
    _required_prim(
        stage,
        str(suction_cfg["reference_prim_path"]),
        "VG10 suction reference",
    )

    base_joint_path = str(paths.get("robot2_base_fixed_joint", ""))
    expected_base = str(paths.get("robot2_base_link", ""))
    if base_joint_path:
        base_joint_prim = _required_prim(
            stage, base_joint_path, "Robot2 base FixedJoint"
        )
        if not base_joint_prim.IsA(UsdPhysics.FixedJoint):
            raise RuntimeError(
                f"Robot2 base joint가 PhysicsFixedJoint가 아닙니다: {base_joint_path}"
            )
        body0 = [
            str(path)
            for path in UsdPhysics.Joint(base_joint_prim).GetBody0Rel().GetTargets()
        ]
        if expected_base not in body0:
            raise RuntimeError(
                f"Robot2 base FixedJoint Body0 불일치: {body0}; "
                f"expected={expected_base}"
            )

    robot1_prim = stage.GetPrimAtPath(paths["robot1"])
    robot2_prim = stage.GetPrimAtPath(paths["robot2"])
    # Articulation Root API가 상위/하위에 적용된 구성도 있으므로 subtree를 확인한다.
    for label, root in (("Robot1", robot1_prim), ("Robot2", robot2_prim)):
        has_root = any(
            prim.HasAPI(UsdPhysics.ArticulationRootAPI)
            for prim in Usd.PrimRange(root)
        )
        if not has_root:
            carb.log_warn(f"[{label}] ArticulationRootAPI를 subtree에서 찾지 못했습니다.")


def _override_camera_time_reset(stage: Usd.Stage, graph_paths: Sequence[str]) -> int:
    """반복 cycle에서 Camera timestamp가 뒤로 가지 않도록 session override한다."""
    changed = 0
    old_target = stage.GetEditTarget()
    try:
        stage.SetEditTarget(Usd.EditTarget(stage.GetSessionLayer()))
        for graph_path in graph_paths:
            root = stage.GetPrimAtPath(graph_path)
            if not root.IsValid():
                continue
            for prim in Usd.PrimRange(root):
                for attr in prim.GetAttributes():
                    name = attr.GetName()
                    lowered = name.lower()
                    if (
                        lowered.endswith("resetsimulationtimeonstop")
                        or lowered.endswith("resetonstop")
                    ):
                        attr.Set(False)
                        changed += 1
    finally:
        stage.SetEditTarget(old_target)
    return changed


def _m0609_config(
    label: str,
    common: Mapping[str, Any],
    robot: Mapping[str, Any],
    tcp_path: str,
) -> M0609Config:
    safe_home_deg = _float_tuple(robot["safe_home_deg"], 6, f"{label}.safe_home_deg")
    safe_home_rad = tuple(float(v) for v in np.deg2rad(safe_home_deg))
    return M0609Config(
        name=label,
        urdf_path=_absolute_file(common["urdf_path"], "m0609.urdf_path"),
        descriptor_path=_absolute_file(
            common["lula_descriptor_path"], "m0609.lula_descriptor_path"
        ),
        end_effector_frame=str(common["end_effector_frame"]),
        tcp_prim_path=tcp_path,
        flange_to_tcp_position_m=_float_tuple(
            robot["flange_to_tcp_position_m"], 3, f"{label}.flange_to_tcp_position_m"
        ),
        flange_to_tcp_quaternion_wxyz=_float_tuple(
            robot["flange_to_tcp_quaternion_wxyz"],
            4,
            f"{label}.flange_to_tcp_quaternion_wxyz",
        ),
        safe_home_joints_rad=safe_home_rad,
        stiffness=_float_tuple(common["stiffness"], 6, "m0609.stiffness"),
        damping=_float_tuple(common["damping"], 6, "m0609.damping"),
        max_effort=_float_tuple(common["max_effort"], 6, "m0609.max_effort"),
        velocity_limit_rad_s=_float_tuple(
            common["velocity_limit_rad_s"], 6, "m0609.velocity_limit_rad_s"
        ),
        apply_runtime_gains=bool(common.get("apply_runtime_gains", True)),
        apply_runtime_effort_limits=bool(
            common.get("apply_max_effort_override", False)
        ),
        minimum_motion_duration_sec=float(common.get("minimum_motion_duration_sec", 0.5)),
        maximum_motion_duration_sec=float(common.get("maximum_motion_duration_sec", 30.0)),
        timeout_scale=float(common.get("timeout_scale", 3.0)),
        timeout_margin_sec=float(common.get("timeout_margin_sec", 3.0)),
        joint_tolerance_rad=float(
            np.deg2rad(float(common.get("joint_tolerance_deg", 2.0)))
        ),
        tcp_position_tolerance_m=float(common.get("tcp_position_tolerance_m", 0.012)),
        tcp_orientation_tolerance_rad=float(
            np.deg2rad(float(common.get("tcp_orientation_tolerance_deg", 8.0)))
        ),
        settle_time_sec=float(common.get("motion_settle_time_sec", 0.15)),
        max_joint_delta_rad=float(
            np.deg2rad(float(common.get("max_joint_delta_deg", 200.0)))
        ),
    )


def _world_only_loop(
    world: World,
    net_root: SingleXFormPrim,
    ros: SimRosInterface,
    render: bool,
    physics_dt: float,
) -> int:
    """월드/Action Graph/표준 ROS 경계만 확인한다."""
    carb.log_info("[NetClean] WORLD_ONLY mode: Ctrl+C로 종료")
    shutting_down = False

    def request_shutdown(_signum=None, _frame=None):
        nonlocal shutting_down
        shutting_down = True

    signal.signal(signal.SIGINT, request_shutdown)
    signal.signal(signal.SIGTERM, request_shutdown)
    step_count = 0
    ready_period_steps = max(1, int(round(1.0 / (1.0 * physics_dt))))
    pose_period_steps = max(1, int(round(1.0 / (20.0 * physics_dt))))
    ros.publish_state("WORLD_ONLY")
    ros.publish_fault("")
    ros.publish_cycle(0)
    ros.publish_ready(True)

    while simulation_app.is_running() and not shutting_down:
        rclpy.spin_once(ros, timeout_sec=0.0)
        # world_only에서는 실행 명령을 모두 명시적으로 거절한다.
        while ros.robot1_requests:
            ros.robot1_requests.popleft()
            ros.publish_robot1_done(False)
        while ros.robot2_requests:
            ros.robot2_requests.popleft()
            ros.publish_robot2_done(False)
        while ros.suction_requests:
            ros.suction_requests.popleft()
            ros.publish_suction_state(False)
        while ros.release_requests:
            ros.release_requests.popleft()
            ros.publish_joint_release_done(False)
        ros.net_targets.clear()
        ros.reset_requests.clear()

        world.step(render=render)
        step_count += 1
        if step_count % pose_period_steps == 0:
            position, orientation = net_root.get_world_pose()
            ros.publish_net_pose(position, orientation)
        if step_count % ready_period_steps == 0:
            ros.publish_ready(True)
            ros.publish_state("WORLD_ONLY")
    return 0


def main() -> int:
    world: Optional[World] = None
    ros: Optional[SimRosInterface] = None
    shutting_down = False

    def request_shutdown(_signum=None, _frame=None):
        nonlocal shutting_down
        shutting_down = True

    signal.signal(signal.SIGINT, request_shutdown)
    signal.signal(signal.SIGTERM, request_shutdown)

    try:
        config = _load_yaml(ARGS.config)
        world_cfg = _section(config, "world")
        runtime_cfg = _section(config, "runtime")
        reset_cfg = dict(config.get("reset", {}))
        paths = _section(config, "prim_paths")
        topics = _section(config, "topics")
        for topic_key, topic_value in topics.items():
            if not str(topic_value).startswith("/"):
                raise ValueError(
                    f"topics.{topic_key}는 절대 Topic 이름이어야 합니다: "
                    f"{topic_value!r}"
                )

        usd_path = ARGS.usd.strip() or str(world_cfg["usd_path"])
        usd_path = _absolute_file(usd_path, "world.usd_path")

        carb.log_info(f"[NetClean] USD open: {usd_path}")
        if not open_stage(usd_path):
            raise RuntimeError(f"USD open 실패: {usd_path}")
        # Payload/reference composition이 끝날 때까지 기다린다.
        _wait_for_stage_loading()
        stage = omni.usd.get_context().get_stage()
        if stage is None:
            raise RuntimeError("USD context에서 Stage를 얻지 못했습니다.")

        _validate_stage(stage, config, full=(ARGS.mode != "world_only"))
        # 모든 runtime Joint enable/disable과 Graph override는 원본 USD가 아닌
        # session layer에만 기록한다.
        stage.SetEditTarget(Usd.EditTarget(stage.GetSessionLayer()))
        changed = _override_camera_time_reset(
            stage,
            [
                paths["clock_graph"],
                paths["camera1_graph"],
                paths["camera2_graph"],
            ],
        )
        carb.log_info(
            f"[NetClean] camera resetSimulationTimeOnStop override count={changed}"
        )

        if ARGS.validate_only:
            print("[NetClean] validation completed", flush=True)
            return 0

        physics_dt = float(runtime_cfg.get("physics_dt", 1.0 / 120.0))
        rendering_dt = float(runtime_cfg.get("rendering_dt", 1.0 / 30.0))
        world = World(
            physics_dt=physics_dt,
            rendering_dt=rendering_dt,
            stage_units_in_meters=float(world_cfg.get("meters_per_unit", 1.0)),
        )

        if ARGS.mode == "world_only":
            net_root_smoke = world.scene.add(
                SingleXFormPrim(prim_path=paths["net_root"], name="net_root_smoke")
            )
            world.reset()
            for _ in range(int(runtime_cfg.get("warmup_steps", 30))):
                world.step(render=not ARGS.headless)
            rclpy.init(args=None)
            ros = SimRosInterface(topics)
            return _world_only_loop(
                world,
                net_root_smoke,
                ros,
                render=not ARGS.headless,
                physics_dt=physics_dt,
            )

        robot1_prim = world.scene.add(
            SingleArticulation(prim_path=paths["robot1"], name="robot1_m0609")
        )
        robot2_prim = world.scene.add(
            SingleArticulation(prim_path=paths["robot2"], name="robot2_m0609")
        )
        net_root = world.scene.add(
            SingleXFormPrim(prim_path=paths["net_root"], name="net_root")
        )
        robot1_tcp = world.scene.add(
            SingleXFormPrim(prim_path=paths["robot1_tcp"], name="robot1_cutter_tcp")
        )
        robot2_tcp = world.scene.add(
            SingleXFormPrim(prim_path=paths["robot2_tcp"], name="robot2_suction_tcp")
        )

        object_configs: Dict[str, TrackedObjectConfig] = {}
        rigid_wrappers: Dict[str, SingleRigidPrim] = {}
        for class_name, item in _section(config, "objects").items():
            rigid_path_value = str(item.get("rigid_body_prim_path", "auto"))
            rigid_path = (
                find_first_rigid_body(stage, str(item["root_prim_path"]))
                if rigid_path_value.lower() == "auto"
                else rigid_path_value
            )
            object_configs[class_name] = TrackedObjectConfig(
                class_name=class_name,
                root_prim_path=str(item["root_prim_path"]),
                net_fixed_joint_path=str(item["net_fixed_joint_path"]),
                rigid_body_prim_path=rigid_path,
            )
            rigid_wrappers[class_name] = world.scene.add(
                SingleRigidPrim(
                    prim_path=rigid_path,
                    name=f"trash_{class_name}",
                )
            )
            carb.log_info(
                f"[object registry] {class_name}: root={item['root_prim_path']}, "
                f"rigid={rigid_path}, joint={item['net_fixed_joint_path']}"
            )

        tracked_objects = {
            name: TrackedObject(stage, object_configs[name], rigid_wrappers[name])
            for name in object_configs
        }

        rclpy.init(args=None)
        ros = SimRosInterface(topics)
        task_holder: Dict[str, NetCleanTask] = {}

        def robot1_result(success: bool, message: str) -> None:
            ros.publish_robot1_done(success)
            carb.log_info(f"[robot1 result] {success}: {message}")
            if "task" in task_holder:
                if success:
                    task_holder["task"].on_robot1_result()
                else:
                    task_holder["task"].report_fault(
                        f"Robot1 저수준 이동 실패: {message}"
                    )

        def robot2_result(success: bool, message: str) -> None:
            ros.publish_robot2_done(success)
            carb.log_info(f"[robot2 result] {success}: {message}")
            if "task" in task_holder:
                if success:
                    task_holder["task"].on_robot2_result()
                else:
                    task_holder["task"].report_fault(
                        f"Robot2 저수준 이동 실패: {message}"
                    )

        def suction_result(actual_enabled: bool, message: str) -> None:
            ros.publish_suction_state(actual_enabled)
            carb.log_info(f"[suction result] state={actual_enabled}: {message}")
            if "task" in task_holder:
                if not actual_enabled and message != "suction open":
                    task_holder["task"].report_fault(
                        f"VG10 흡착 실패: {message}"
                    )
                else:
                    task_holder["task"].on_suction_result()

        def joint_release_result(success: bool, message: str) -> None:
            ros.publish_joint_release_done(success)
            carb.log_info(f"[joint release result] {success}: {message}")
            if not success and "task" in task_holder:
                task_holder["task"].report_fault(
                    f"Net FixedJoint 해제 실패: {message}"
                )

        suction_cfg = _section(config, "suction")
        suction = RuntimeSuctionController(
            stage=stage,
            robot_link_prim_path=paths["robot2_link6"],
            suction_tcp=robot2_tcp,
            objects=tracked_objects,
            runtime_root_path=str(
                suction_cfg.get("runtime_root_path", "/World/NetCleanRuntime")
            ),
            max_grip_distance_m=float(suction_cfg.get("max_grip_distance_m", 0.04)),
            settle_time_sec=float(suction_cfg.get("settle_time_sec", 0.15)),
            result_callback=suction_result,
            reference_prim_path=str(
                suction_cfg.get("reference_prim_path", paths["robot2_link6"])
            ),
            forward_axis_local=_float_tuple(
                suction_cfg.get("forward_axis_local", [-1.0, 0.0, 0.0]),
                3,
                "suction.forward_axis_local",
            ),
            minimum_forward_projection_m=float(
                suction_cfg.get("minimum_forward_projection_m", -0.01)
            ),
        )

        # Runtime suction joints까지 stage에 정의된 뒤 한 번 reset하여 모든
        # Scene wrapper와 PhysX joint를 초기화한다. 여기서 authored 0° 자세로
        # 여러 step을 보내지 않는다. 아래 task.start()가 첫 simulation step 전에
        # 두 M0609를 SAFE_HOME으로 복구하고, STARTUP_STABILIZE에서 안정화한다.
        world.reset()

        m0609_cfg = _section(config, "m0609")
        robot1_cfg = _section(config, "robot1")
        robot2_cfg = _section(config, "robot2")
        robot1_controller = M0609Controller(
            robot=robot1_prim,
            tcp_prim=robot1_tcp,
            config=_m0609_config("robot1", m0609_cfg, robot1_cfg, paths["robot1_tcp"]),
            result_callback=robot1_result,
        )
        robot2_controller = M0609Controller(
            robot=robot2_prim,
            tcp_prim=robot2_tcp,
            config=_m0609_config("robot2", m0609_cfg, robot2_cfg, paths["robot2_tcp"]),
            result_callback=robot2_result,
        )

        authored_root_position, authored_root_orientation = net_root.get_world_pose()
        for obj in tracked_objects.values():
            obj.snapshot_relative_to_root(
                authored_root_position,
                authored_root_orientation,
            )

        rail_cfg = _section(config, "rail")
        spawn_xyz = _float_tuple(rail_cfg["spawn_xyz"], 3, "rail.spawn_xyz")
        start_xyz = _float_tuple(rail_cfg["start_xyz"], 3, "rail.start_xyz")
        allowed_ys = [
            float(spawn_xyz[1]),
            float(start_xyz[1]),
            float(_float_tuple(rail_cfg["station1_xyz"], 3, "station1")[1]),
            float(_float_tuple(rail_cfg["station2_xyz"], 3, "station2")[1]),
            float(_float_tuple(rail_cfg["exit_xyz"], 3, "exit")[1]),
        ]
        net_controller = NetRailController(
            net_root=net_root,
            objects=tracked_objects.values(),
            fixed_x=float(start_xyz[0]),
            fixed_z=float(start_xyz[2]),
            minimum_y=min(allowed_ys),
            maximum_y=max(allowed_ys),
            speed_mps=float(rail_cfg.get("speed_mps", 0.30)),
            position_tolerance_m=float(rail_cfg.get("position_tolerance_m", 0.015)),
            settle_time_sec=float(rail_cfg.get("settle_time_sec", 0.20)),
            command_xz_tolerance_m=float(
                rail_cfg.get("command_xz_tolerance_m", 0.02)
            ),
        )

        joint_release = FixedJointReleaseController(
            stage=stage,
            objects=tracked_objects,
            suction=suction,
            aliases=_section(config, "class_aliases"),
            result_callback=joint_release_result,
        )

        operational = {"ready": False}

        def ready_callback(value: bool) -> None:
            operational["ready"] = bool(value)
            ros.publish_ready(value)

        def reset_done_callback(success: bool, message: str) -> None:
            ros.publish_reset_done(success)
            carb.log_info(f"[reset result] {success}: {message}")

        task = NetCleanTask(
            net=net_controller,
            objects=tracked_objects,
            robot1=robot1_controller,
            robot2=robot2_controller,
            suction=suction,
            joint_release=joint_release,
            reset_config=ResetConfig(
                spawn_xyz=spawn_xyz,
                start_xyz=start_xyz,
                stabilize_steps=int(
                    reset_cfg.get(
                        "stabilize_steps",
                        runtime_cfg.get("reset_stabilize_steps", 45),
                    )
                ),
                robot_home_tolerance_rad=float(
                    np.deg2rad(
                        float(
                            reset_cfg.get(
                                "robot_home_tolerance_deg",
                                m0609_cfg.get("home_tolerance_deg", 2.0),
                            )
                        )
                    )
                ),
                net_tolerance_m=float(
                    reset_cfg.get(
                        "net_position_tolerance_m",
                        rail_cfg.get("position_tolerance_m", 0.015),
                    )
                ),
                object_position_tolerance_m=float(
                    reset_cfg.get("object_position_tolerance_m", 0.02)
                ),
                object_orientation_tolerance_rad=float(
                    np.deg2rad(
                        float(reset_cfg.get("object_orientation_tolerance_deg", 5.0))
                    )
                ),
                object_linear_speed_tolerance_mps=float(
                    reset_cfg.get("object_linear_speed_tolerance_mps", 0.05)
                ),
                object_angular_speed_tolerance_rad_s=float(
                    reset_cfg.get("object_angular_speed_tolerance_rad_s", 0.10)
                ),
            ),
            ready_callback=ready_callback,
            reset_done_callback=reset_done_callback,
            state_callback=ros.publish_state,
            fault_callback=ros.publish_fault,
            cycle_callback=ros.publish_cycle,
        )
        task_holder["task"] = task
        task.start()

        ready_period_steps = max(
            1,
            int(round(1.0 / max(1.0e-6, float(runtime_cfg.get("ready_publish_hz", 1.0))) / physics_dt)),
        )
        pose_period_steps = max(
            1,
            int(round(1.0 / max(1.0e-6, float(runtime_cfg.get("net_pose_publish_hz", 20.0))) / physics_dt)),
        )
        step_count = 0

        carb.log_info(
            f"[NetClean] {ARGS.mode.upper()} mode started; waiting for startup reset"
        )
        while simulation_app.is_running() and not shutting_down:
            rclpy.spin_once(ros, timeout_sec=0.0)

            # Reset은 나머지 command보다 항상 우선한다.
            if ros.reset_requests:
                ros.reset_requests.clear()
                ros.clear_work_queues(preserve_reset=False)
                task.request_reset()

            while ros.net_targets:
                target = ros.net_targets.popleft()
                if not task.submit_net_target(target):
                    ros.get_logger().error(
                        f"Net 명령 거부: state={task.state.name}, target={target.tolist()}"
                    )

            while ros.robot1_requests:
                request = ros.robot1_requests.popleft()
                if ARGS.mode == "net_only" or not task.submit_robot1(request):
                    ros.get_logger().error(
                        f"Robot1 명령 거부: mode={ARGS.mode}, state={task.state.name}"
                    )
                    ros.publish_robot1_done(False)

            while ros.robot2_requests:
                request = ros.robot2_requests.popleft()
                if ARGS.mode == "net_only" or not task.submit_robot2(request):
                    ros.get_logger().error(
                        f"Robot2 명령 거부: mode={ARGS.mode}, state={task.state.name}"
                    )
                    ros.publish_robot2_done(False)

            while ros.suction_requests:
                enabled = ros.suction_requests.popleft()
                if ARGS.mode == "net_only" or not task.submit_suction(enabled):
                    ros.get_logger().error(
                        f"Suction 명령 거부: state={task.state.name}, enabled={enabled}"
                    )
                    # Robot2 node는 기대 상태가 와야 wait를 해제한다.
                    ros.publish_suction_state(suction.attached)

            while ros.release_requests:
                class_name = ros.release_requests.popleft()
                if ARGS.mode == "net_only" or not task.submit_joint_release(class_name):
                    ros.get_logger().error(
                        f"Joint release 명령 거부: state={task.state.name}, "
                        f"class={class_name}"
                    )
                    ros.publish_joint_release_done(False)

            task.update(physics_dt)
            world.step(render=not ARGS.headless)
            step_count += 1

            if step_count % pose_period_steps == 0:
                position, orientation = net_controller.get_world_pose()
                ros.publish_net_pose(position, orientation)
            if step_count % ready_period_steps == 0:
                ros.publish_ready(operational["ready"])

        return 0

    except Exception as exc:
        print(
            f"[NetClean] fatal error: {type(exc).__name__}: {exc}",
            file=sys.stderr,
            flush=True,
        )
        carb.log_error(f"[NetClean] fatal error: {type(exc).__name__}: {exc}")
        if ros is not None:
            try:
                ros.publish_fault(f"fatal: {type(exc).__name__}: {exc}")
                ros.publish_ready(False)
            except Exception:
                pass
        return 1

    finally:
        if ros is not None:
            try:
                ros.publish_ready(False)
                ros.destroy_node()
            except Exception:
                pass
        if rclpy.ok():
            rclpy.shutdown()
        if world is not None:
            try:
                world.stop()
                world.clear_instance()
            except Exception:
                pass
        simulation_app.close()


if __name__ == "__main__":
    sys.exit(main())
